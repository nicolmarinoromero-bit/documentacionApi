# Puerto local del servidor
PORT=3000

# Secreto usado para firmar tokens JWT.
# Reemplázalo por un valor privado y seguro en el archivo .env.
JWT_SECRET=cambia-este-secreto-por-uno-seguro
JWT_EXPIRES_IN=8h

# Zona horaria usada para fechas y cierres de caja
ZONA_HORARIA=America/Bogota

# Reglas de operación
MINUTOS_ANULACION=10
MINUTOS_CIERRE_VENTAS=15
APUESTA_MIN_CHANCE=500
APUESTA_MAX_CHANCE=50000
VALOR_BALOTO=5700
DIAS_CADUCIDAD_PREMIO=365